digraph content_pipeline {
  graph [
    rankdir=TB,
    newrank=true,
    compound=true,
    splines=spline,
    nodesep=0.4,
    ranksep=0.5,
    pad=0.35,
    bgcolor="#FFFFFF",
    fontname="Noto Sans",
    fontsize=22,
    labelloc="t",
    label="Content delivery pipeline\n(git-versioned content -> validated -> live in every scoped Course)\nInvariant: green pipeline <=> that sha is live exactly where it scopes; red <=> nothing of it shipped",
    fontcolor="#1F2933"
  ]

  node [
    fontname="Noto Sans",
    fontsize=11,
    shape=box,
    style="rounded,filled",
    color="#4A78B5",
    fillcolor="#EAF2FB",
    penwidth=1.4,
    margin="0.14,0.08"
  ]

  edge [
    fontname="Noto Sans",
    fontsize=9,
    color="#5B6770",
    fontcolor="#5B6770",
    penwidth=1.3,
    arrowsize=0.7
  ]

  teacher [label="Teacher / maintainer\ngit push", fillcolor="#F2F2F2", color="#777777"];

  subgraph cluster_gitlab {
    label="GitLab the project";
    fontsize=13;
    fontcolor="#B7950B";
    style="rounded";
    color="#B7950B";
    margin=12;

    qkb      [label="QKB repos\nfixbot/qkb/<slug>-<year>\nquestions + mapping + assets", fillcolor="#FFF9DB", color="#B7950B"];
    prompts  [label="Pipes / sys-prompts\nmain.txt per Type", fillcolor="#FFF9DB", color="#B7950B"];
    bases    [label="Pipes / pipe-bases\nmain.py per Type", fillcolor="#FFF9DB", color="#B7950B"];
    schema   [label="qkb-schema\nJSON schemas + tags", fillcolor="#FFF9DB", color="#B7950B"];
    cci      [label="fixbot-content-ci\nshared pipeline", fillcolor="#FFF9DB", color="#B7950B"];
  }

  validate [label="validate stage\nschema + lint\n(green pipeline)", fillcolor="#E8F5EC", color="#3E8E5A"];
  rehearse [label="rehearse stage (--test)\nthrowaway tree, no publish\nwrites prefixed copies to test Course", style="rounded,filled,dashed", fillcolor="#FFFFFF", color="#3E8E5A"];

  subgraph cluster_control {
    label="Pipe Control";
    fontsize=13;
    fontcolor="#4A78B5";
    style="rounded";
    color="#4A78B5";
    margin=12;

    sync  [label="POST /sync?wait=1\nsingle serialized wait queue", fillcolor="#EAF2FB", color="#4A78B5"];
    repos [label="GET /repos\nper-repo epoch HEADs\n(= volume green memory)", fillcolor="#EAF2FB", color="#4A78B5"];
  }

  subgraph cluster_job {
    label="Propagate Job  (fixbot-pipe-propagate-*)";
    fontsize=13;
    fontcolor="#3E8E5A";
    style="rounded";
    color="#3E8E5A";
    margin=12;

    clone   [label="clone caller repo\nat exact pushed sha\nread-only token, optional proxy\n(only around git fetch)", fillcolor="#E8F5EC", color="#3E8E5A"];
    publish [label="publish per-file\nreplace + prune\nfiles first, then .git", fillcolor="#E8F5EC", color="#3E8E5A"];
    cli     [label="pipe_control CLI\nloader + --only-repo\n(-v logs -> Loki)", fillcolor="#E8F5EC", color="#3E8E5A"];
  }

  contentpvc [label="Shared content PVC\nsys-prompts / pipe-bases / qkb", shape=cylinder, fillcolor="#F3EAFB", color="#7B4FA6"];

  subgraph cluster_target {
    label="Scoped target Courses";
    fontsize=13;
    fontcolor="#3E8E5A";
    style="rounded";
    color="#3E8E5A";
    margin=12;

    statedb [label="Pipe State DB\nPipes, valves, sessions", shape=cylinder, fillcolor="#F3EAFB", color="#7B4FA6"];
    owui    [label="Open WebUI\nPipes + model config", fillcolor="#E8F5EC", color="#3E8E5A"];
    assets  [label="/qkb-assets/<token>/<file>\ninline question figures", fillcolor="#E8F5EC", color="#3E8E5A"];
  }

  reconcile [label="content-reconcile CronJob\nevery 5 min, scope=full\ndeploy-only: never re-fetches", style="rounded,filled,dashed", fillcolor="#FFFFFF", color="#4A78B5"];

  { rank=same; qkb; prompts; bases; schema; cci; }
  { rank=same; validate; rehearse; }
  { rank=same; sync; repos; reconcile; }
  { rank=same; clone; publish; cli; }
  { rank=same; contentpvc; statedb; owui; assets; }

  teacher -> qkb     [label="push"];
  teacher -> prompts [label="push"];
  teacher -> bases   [label="push"];

  qkb -> validate;
  prompts -> validate;
  bases -> validate;
  schema -> validate [label="lint rules", style=dashed];
  cci -> validate    [style=dotted, label="pipeline"];

  validate -> sync [label="POST {repo, sha}\nonly if green"];
  validate -> rehearse [label="optional gate", style=dashed, constraint=false];
  rehearse -> sync [label="never advances\nthe green epoch", style=dotted, constraint=false];

  sync -> clone    [label="spawn Job\n(sha-bearing call)"];
  clone -> publish [label="checkout exact sha"];
  publish -> contentpvc [label="atomic per-file replace"];
  publish -> cli [label="then runs CLI", style=dotted];
  cli -> statedb [label="upsert Pipes / valves"];
  cli -> owui    [label="model config"];

  contentpvc -> owui   [label="subPath mount", style=dashed, constraint=false];
  contentpvc -> assets [label="Pipe Control serves from tree", style=dashed, constraint=false];

  reconcile -> sync [label="sha-less -> DEPLOY-ONLY\nconverge to published HEADs", style=dotted];
}
